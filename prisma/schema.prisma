generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DISCONTINUED
  TEMPORARILY_OUT_OF_STOCK
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTE_SENT
  NEGOTIATION
  SALE_CONFIRMED
  PRODUCTION
  DELIVERY
  POST_SALE
  RECURRING_CLIENT
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductionStatus {
  PENDING
  SCHEDULED
  IN_MANUFACTURING
  QUALITY_CONTROL
  FINISHED
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  IN_ROUTE
  DELIVERED
  RESCHEDULED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Company {
  id             String        @id @default(uuid()) @db.Uuid
  businessName   String        @map("business_name")
  commercialName String?       @map("commercial_name")
  taxId           String?       @unique @map("tax_id")
  phone           String?
  email           String?
  website         String?
  address         String?
  city            String?
  state           String?
  country         String        @default("México")
  postalCode      String?       @map("postal_code")
  notes           String?
  status          CompanyStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  contacts        Contact[]
  crmLeads        Lead[]

  @@index([businessName])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  mobile    String?
  email     String?
  position  String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  crmLeads  Lead[]

  @@index([companyId])
  @@map("contacts")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  name      String
  phone     String?
  status    UserStatus @default(ACTIVE)
  roleId    String     @map("role_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  role                 Role                  @relation(fields: [roleId], references: [id])
  assignedLeads        Lead[]                @relation("LeadAssignedUser")
  assignedTasks        Task[]                @relation("TaskAssignedUser")
  createdProducts      Product[]             @relation("ProductCreatedBy")
  updatedProducts      Product[]             @relation("ProductUpdatedBy")
  createdMedia         Media[]               @relation("MediaCreatedBy")
  activityLogs         ActivityLog[]
  notes                Note[]
  createdHeroSlides    HeroSlide[]           @relation("HeroSlideCreatedBy")
  updatedHeroSlides    HeroSlide[]           @relation("HeroSlideUpdatedBy")
  createdFaqEntries    Faq[]                 @relation("FaqCreatedBy")
  updatedFaqEntries    Faq[]                 @relation("FaqUpdatedBy")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  sku              String        @unique
  name             String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  fullDescription  String?       @map("full_description")
  brand            String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  displayOrder     Int           @default(0) @map("display_order")
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  ogTitle          String?       @map("og_title")
  ogDescription    String?       @map("og_description")
  createdById      String?       @map("created_by") @db.Uuid
  updatedById      String?       @map("updated_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  createdBy       User?              @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?              @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  categories      ProductCategory[]
  relatedFrom     ProductRelation[]  @relation("RelatedFrom")
  relatedTo       ProductRelation[]  @relation("RelatedTo")
  orderItems      OrderItem[]
  productionItems ProductionOrder[]

  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  description  String?
  parentId     String?   @map("parent_id") @db.Uuid
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Color {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  hexCode   String?   @map("hex_code")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  variants ProductVariant[]

  @@map("colors")
}

model ProductVariant {
  id                   String    @id @default(uuid()) @db.Uuid
  productId            String    @map("product_id") @db.Uuid
  colorId              String?   @map("color_id") @db.Uuid
  sku                  String    @unique
  name                 String
  slug                 String    @unique
  configuration        String?
  dimensions           String?
  price                Decimal?  @db.Decimal(12, 2)
  estimatedProductionDays Int?   @map("estimated_production_days")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  color            Color?            @relation(fields: [colorId], references: [id])
  images           ProductImage[]
  orderItems       OrderItem[]
  productionOrders ProductionOrder[]

  @@index([productId])
  @@index([colorId])
  @@map("product_variants")
}

model ProductImage {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  mediaId     String?   @map("media_id") @db.Uuid
  url         String
  altText     String?   @map("alt_text")
  imageType   String?   @map("image_type")
  isPrimary   Boolean   @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  media   Media?          @relation(fields: [mediaId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_images")
}

model ProductRelation {
  productId        String   @map("product_id") @db.Uuid
  relatedProductId String   @map("related_product_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@map("product_relations")
}

model Lead {
  id             String          @id @default(uuid()) @db.Uuid
  assignedUserId String?         @map("assigned_user_id") @db.Uuid
  clientId       String?         @unique @map("client_id") @db.Uuid
  firstName      String?         @map("first_name")
  lastName       String?         @map("last_name")
  companyName    String?         @map("company_name")
  email          String?
  phone          String?
  source         String?
  status         LeadStatus      @default(NEW)
  temperature    LeadTemperature?
  message        String?
  lostReason     String?         @map("lost_reason")
  companyId      String?         @map("company_id") @db.Uuid
  contactId      String?         @map("contact_id") @db.Uuid
  crmStatus      CrmLeadStatus   @default(NEW) @map("crm_status")
  pipelineStage  String          @default("NEW") @map("pipeline_stage")
  estimatedValue Decimal?        @map("estimated_value") @db.Decimal(12, 2)
  probability    Int             @default(0)
  crmNotes       String?         @map("crm_notes_text")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  assignedUser User?         @relation("LeadAssignedUser", fields: [assignedUserId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  pipeline     CrmPipeline[]
  notes        Note[]
  tasks        Task[]
  orders       Order[]

  @@index([assignedUserId])
  @@index([status])
  @@index([companyId])
  @@index([contactId])
  @@index([crmStatus])
  @@map("leads")
}

model Client {
  id          String    @id @default(uuid()) @db.Uuid
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  companyName String?   @map("company_name")
  email       String?
  phone       String?
  taxId       String?   @map("tax_id")
  address     String?
  city        String?
  state       String?
  country     String?   @default("México")
  postalCode  String?   @map("postal_code")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  lead   Lead?
  orders Order[]
  notes  Note[]
  tasks  Task[]

  @@index([email])
  @@index([phone])
  @@map("clients")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number")
  clientId    String      @map("client_id") @db.Uuid
  leadId      String?     @map("lead_id") @db.Uuid
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal?    @db.Decimal(12, 2)
  total       Decimal?    @db.Decimal(12, 2)
  notes       String?
  confirmedAt DateTime?   @map("confirmed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  client           Client            @relation(fields: [clientId], references: [id])
  lead             Lead?             @relation(fields: [leadId], references: [id])
  items            OrderItem[]
  productionOrders ProductionOrder[]
  deliveries       Delivery[]
  crmNotes         Note[]
  tasks            Task[]

  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  quantity    Int      @default(1)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal? @map("total_price") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  productionOrders ProductionOrder[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model ProductionOrder {
  id                  String           @id @default(uuid()) @db.Uuid
  orderId             String           @map("order_id") @db.Uuid
  orderItemId         String?          @map("order_item_id") @db.Uuid
  productId           String?          @map("product_id") @db.Uuid
  variantId           String?          @map("variant_id") @db.Uuid
  status              ProductionStatus @default(PENDING)
  scheduledStartDate  DateTime?        @map("scheduled_start_date")
  startedAt           DateTime?        @map("started_at")
  estimatedCompletion DateTime?        @map("estimated_completion")
  completedAt         DateTime?        @map("completed_at")
  observations        String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  order     Order           @relation(fields: [orderId], references: [id])
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  deliveries Delivery[]

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
  @@map("production_orders")
}

model Delivery {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  productionOrderId   String?        @map("production_order_id") @db.Uuid
  status              DeliveryStatus @default(PENDING)
  scheduledAt         DateTime?      @map("scheduled_at")
  deliveredAt         DateTime?      @map("delivered_at")
  recipientName       String?        @map("recipient_name")
  recipientPhone      String?        @map("recipient_phone")
  address             String?
  evidenceUrl         String?        @map("evidence_url")
  incidentDescription String?        @map("incident_description")
  observations        String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  order           Order            @relation(fields: [orderId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@index([orderId])
  @@index([productionOrderId])
  @@index([status])
  @@map("deliveries")
}

model CrmPipeline {
  id          String     @id @default(uuid()) @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  stage       LeadStatus
  enteredAt   DateTime   @default(now()) @map("entered_at")
  exitedAt    DateTime?  @map("exited_at")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([stage])
  @@map("crm_pipeline")
}

model Note {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  leadId    String?   @map("lead_id") @db.Uuid
  clientId  String?   @map("client_id") @db.Uuid
  orderId   String?   @map("order_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author User?   @relation(fields: [authorId], references: [id])
  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@index([authorId])
  @@index([leadId])
  @@index([clientId])
  @@index([orderId])
  @@map("crm_notes")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  assignedUserId String?      @map("assigned_user_id") @db.Uuid
  leadId         String?      @map("lead_id") @db.Uuid
  clientId       String?      @map("client_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?    @map("due_at")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  assignedUser User?   @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  lead         Lead?   @relation(fields: [leadId], references: [id])
  client       Client? @relation(fields: [clientId], references: [id])
  order        Order?  @relation(fields: [orderId], references: [id])

  @@index([assignedUserId])
  @@index([leadId])
  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@map("tasks")
}

model HeroSlide {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  subtitle            String?
  description         String?
  desktopImageUrl     String?   @map("desktop_image_url")
  tabletImageUrl      String?   @map("tablet_image_url")
  mobileImageUrl      String?   @map("mobile_image_url")
  altText             String?   @map("alt_text")
  primaryButtonLabel  String?   @map("primary_button_label")
  primaryButtonUrl    String?   @map("primary_button_url")
  secondaryButtonLabel String?  @map("secondary_button_label")
  secondaryButtonUrl  String?   @map("secondary_button_url")
  displayOrder        Int       @default(0) @map("display_order")
  isActive            Boolean   @default(false) @map("is_active")
  startsAt            DateTime? @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  createdById         String?   @map("created_by") @db.Uuid
  updatedById         String?   @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  createdBy User? @relation("HeroSlideCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("HeroSlideUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive])
  @@map("hero_slides")
}

model Faq {
  id           String    @id @default(uuid()) @db.Uuid
  question     String
  answer       String
  category     String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  createdBy User? @relation("FaqCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("FaqUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive])
  @@map("faq")
}

model Setting {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  value       Json
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("settings")
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  type        MediaType @default(IMAGE)
  url         String
  filename    String?
  mimeType    String?   @map("mime_type")
  sizeBytes   Int?      @map("size_bytes")
  altText     String?   @map("alt_text")
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy     User?          @relation("MediaCreatedBy", fields: [createdById], references: [id])
  productImages ProductImage[]

  @@index([type])
  @@map("media")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  action     String
  metadata   Json?
  result     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
