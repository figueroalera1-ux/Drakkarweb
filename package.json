{
  "name": "tiendas-drakkar",
  "version": "0.1.0",
  "private": true,
  "description": "Production foundation for the Tiendas Drakkar commercial platform.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "api:dev": "tsx watch src/backend/http/server.ts",
    "api:start": "tsx src/backend/http/server.ts",
    "dev:all": "npm run dev & npm run api:dev"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.17",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
